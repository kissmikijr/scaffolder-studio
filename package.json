{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20 || 22"
  },
  "scripts": {
    "dev": "yarn workspaces foreach -A --include backend --include app --parallel --jobs unlimited -v -i run start",
    "db": "docker ps -a | grep -q \"scaffolder_studio_db\" && docker stop scaffolder_studio_db && docker rm scaffolder_studio_db; docker run -d --name scaffolder_studio_db --env POSTGRES_HOST_AUTH_METHOD=trust -p 5433:5432 postgres:16 -c max_connections=191",
    "start": "yarn workspace app start",
    "start:alpha": "yarn workspace app start:alpha",
    "start-backend": "yarn workspace backend start",
    "build:backend": "yarn workspace backend build",
    "build:all": "yarn tsc && backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "new": "backstage-cli new",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "yarn workspaces foreach -A --no-private --topological-dev npm publish --tolerate-republish",
    "prepare": "husky"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "plugins/*"
    ]
  },
  "devDependencies": {
    "@backstage/cli": "^0.35.4",
    "@backstage/e2e-test-utils": "^0.1.2",
    "@changesets/cli": "^2.27.1",
    "@playwright/test": "^1.32.3",
    "@types/jest": "^30.0.0",
    "@types/lodash.debounce": "^4",
    "@types/luxon": "^3",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "node-gyp": "^10.0.0",
    "prettier": "^2.3.2",
    "typescript": "~5.8.0"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "ai": "^6.0.27",
    "@lezer/common": "1.2.1",
    "@lezer/lr": "1.4.1",
    "@lezer/highlight": "1.2.0",
    "isolated-vm": "5.0.3"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.12.0",
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "lodash.debounce": "^4.0.8",
    "luxon": "^3.6.1"
  }
}
